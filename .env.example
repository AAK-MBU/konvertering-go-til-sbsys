# Kopiér til .env og udfyld. .env må ALDRIG committes.
# På Automation Server sættes SBSYS_CLIENT_ID/SECRET og databasebruger
# i stedet via credential-store — se automation/main.py.

KONV_MILJOE=test              # test | preprod | prod
KONV_DRY_RUN=1                # 1 = send intet til SBSYS
KONV_LOG_NIVEAU=INFO
KONV_MASKER=1                 # maskér CPR/CVR/e-mail i logs — aldrig 0 i prod
KONV_BATCH=200
KONV_KODEVERSION=             # udfyldes af CI med git sha

# --- Konverteringsdatabasen (ikke GO_RAW, ikke SBSYS' egen base) ---
KONV_DB_SERVER=sqlsrv-mbu-test.aarhuskommune.dk
KONV_DB_DATABASE=SBSYS_KONV
# Serveren er SQL Server på Linux -> SQL-autentificering. Sæt 1 hvis I
# kører mod en Windows-instans med Kerberos.
KONV_DB_TRUSTED=0            # 1 kun ved Windows-auth/Kerberos
KONV_DB_BRUGER=konv_runtime
KONV_DB_KODEORD=
# Driveren skal vaere installeret. Har I kun 17:
#   KONV_DB_DRIVER=ODBC Driver 17 for SQL Server
# Testserver med selvsigneret certifikat kraever 1. Afvises i produktion.
KONV_DB_TRUST_CERT=1

# --- SBSYS API ---
# Standard er attrappen (tools/falsk_sbsys.py), saa en frisk .env peger et
# sted der FAKTISK svarer. Et vaertsnavn der ser rigtigt ud, men ikke findes,
# giver en DNS-fejl man bruger tid paa at lede efter.
SBSYS_BASE_URL=http://localhost:8080
SBSYS_TOKEN=attrap
# Det rigtige testmiljoe — udkommenter naar adressen er bekraeftet, og
# fjern SBSYS_TOKEN ovenfor (et statisk token vinder over alt andet):
# SBSYS_BASE_URL=https://<det-rigtige-vaertsnavn>
# SBSYS_TOKEN_URL=https://<host>/auth/realms/sbsip/protocol/openid-connect/token
#
# SBSYS' snitflade bruger OAuth2 password grant: klienten identificerer
# INTEGRATIONEN, brugeren identificerer HVEM handlingerne udfoeres som.
# Begge dele skal udfyldes. Kontoen skal vaere en navngiven servicekonto
# (ikke en medarbejders) med rettigheder til ALLE afdelinger der
# konverteres — ellers fejler foerst den boelge der rammer en afdeling
# kontoen ikke maa noget i.
SBSYS_CLIENT_ID=
SBSYS_CLIENT_SECRET=
SBSYS_USERNAME=
SBSYS_PASSWORD=
SBSYS_SCOPE=
SBSYS_MAKS_FORSOEG=5
SBSYS_MAKS_SAMTIDIGE=4
SBSYS_KALD_PR_SEKUND=8        # aftal loftet med SBSYS-driften før prod

# Kontrol af SBSYS' TLS-certifikat. Fire former:
#   system                verificér mod OPERATIVSYSTEMETS certifikatlager
#                         <- anbefalet paa en kommunal Windows-pc: kommunens
#                            rod-CA ligger der i forvejen. Intet at eksportere.
#   1                     verificér mod Pythons EGET CA-lager (certifi).
#                         Kender IKKE kommunens rod-CA -> fejler mod testmiljoeet
#   C:/certs/ca-rod.pem   verificér mod netop det CA-bundt (kommunens rod-CA).
#                         Til en server hvor CA'en ikke ligger i systemets lager
#   0                     verificér ikke. KUN test; afvises i produktion.
# Et internt testmiljoe har et certifikat fra kommunens egen CA, som Python
# ikke kender af sig selv. Loesningen er "system" eller stien — ikke at slaa
# verifikationen fra: uden den kan forbindelsen aflyttes og aendres
# undervejs, og der gaar persondata om boern og unge over den.
# Kontrol: aabner testmiljoeets adresse i Edge uden certifikatadvarsel, saa
# kender Windows CA'en, og "system" virker.
SBSYS_VERIFY=system

# --- Boern og Unge-API'et (foranstaltninger) ---
# En SELVSTAENDIG tjeneste paa sin egen vaert, med snake_case-stier
# (bu_api/sag_foranstaltning). Tokenet fra SBSYS gaelder ogsaa dér
# (bekraeftet 09-11-2026), saa kun adressen skal udfyldes.
#
# KUN VAERTEN — ikke /bu_api til sidst. Stierne indeholder den selv.
#   Rigtigt:  https://boernogungeapi.<miljoe>
#   Forkert:  https://boernogungeapi.<miljoe>/bu_api
SBSYS_BU_BASE_URL=

# Stier og feltnavne pr. SBSYS-version — se sbsys/endpoints.example.toml
KONV_ENDPOINTS=sbsys/endpoints.toml

# --- Dokumentfiler fra GO's fileshare-eksport ---
# Windows: brug skraastreg, fx C:/temp/go-filer
KONV_FIL_ROD=/mnt/go-eksport/dokumenter
KONV_FIL_MAKS_MB=250
